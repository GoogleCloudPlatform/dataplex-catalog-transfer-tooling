#!/bin/bash

# ---------- Check gcloud auth ----------
echo "Checking authentication..."
if ! gcloud auth list --filter=status:ACTIVE --format="value(account)" | grep -q .; then
 echo "No active gcloud auth session found. Logging in..."
 gcloud auth login
else
 echo "gcloud is already authenticated."
fi


# ---------- Configuration ----------
# Mandatory parameters: SCOPE, SERVICE_ACCOUNT and ASPECT_TYPE_PROJECT_ID
# These parameters must be explicitly set before running the script.

# SCOPE: Defines the scope of projects for the process.
# Should be formatted as:
#   - "organizations/{orgNumber}" (e.g., "organizations/123456789012")
#   - "folders/{folderNumber}" (e.g., "folders/987654321098")
#   - "projects/{projectNumber}" (e.g., "projects/123456789012")
SCOPE=""

# SERVICE_ACCOUNT: The email of the service account to be used for authentication.
# Example format:
#   SERVICE_ACCOUNT="your-service-account@your-project.iam.gserviceaccount.com"
SERVICE_ACCOUNT=""

# ASPECT_TYPE_PROJECT_ID: Set only if the Lakes and Zones Search functionality is planned for installation.
# This project will be used to store references to the lake and zone.
# Example format:
#   ASPECT_TYPE_PROJECT_ID="aspect-type-project-id"
ASPECT_TYPE_PROJECT_ID=""

# Optional parameters: These can be left unchanged or modified as needed.
REGION="us-central1"  # Default region for deployment
# This repository stores public Docker images. To use your own registry, update the value below.
# Format: REGISTRY="<registry-domain>/<project>/<repository>"
# You can build the images using the provided cloudbuild.yaml file.
REGISTRY="us-docker.pkg.dev/dataplex-transfer-tooling/dataplex-transfer-tooling"  # Docker registry for images
SINK_NAME="data-catalog-audit-logs"  # Sink name for audit logs

DEBUG=false
FAILED_ACTIONS=()

# ---------- Interactive Component Selection ----------
echo ""
echo "🎯 Welcome to Dataplex Transfer Tooling Setup!"
echo "=============================================="
echo ""
echo "Please select which components you want to install:"
echo ""

ask_yes_no() {
    local question="$1"
    local response
    while true; do
        read -p "$question (y/n): " response
        case $response in
            [Yy]* ) return 0;;
            [Nn]* ) return 1;;
            * ) echo "Please answer yes (y) or no (n).";;
        esac
    done
}

INSTALL_DATA_DISCOVERY=false
INSTALL_IMPACT_ANALYSIS=false
INSTALL_TRANSFER_AT_SCALE=false
INSTALL_CLEAN_UP=false
INSTALL_MONITORING=false
INSTALL_LAKES_ZONES=false

if ask_yes_no "1️⃣  Install Data Discovery functionality?"; then
    INSTALL_DATA_DISCOVERY=true
    echo "   ✅ Data Discovery will be installed"
else
    echo "   ❌ Data Discovery will be skipped"
fi

if ask_yes_no "2️⃣  Install Impact Analysis functionality?"; then
    INSTALL_IMPACT_ANALYSIS=true
    echo "   ✅ Impact Analysis will be installed (includes audit log configuration)"
else
    echo "   ❌ Impact Analysis will be skipped"
fi

if ask_yes_no "3️⃣  Install Transfer at Scale functionality?"; then
    INSTALL_TRANSFER_AT_SCALE=true
    echo "   ✅ Transfer at Scale will be installed"
else
    echo "   ❌ Transfer at Scale will be skipped"
fi

if ask_yes_no "4️⃣  Install Clean Up functionality?"; then
    INSTALL_CLEAN_UP=true
    echo "   ✅ Clean Up will be installed"
else
    echo "   ❌ Clean Up will be skipped"
fi

if ask_yes_no "5️⃣  Install Monitoring Dashboard?"; then
    INSTALL_MONITORING=true
    echo "   ✅ Monitoring Dashboard will be installed"
else
    echo "   ❌ Monitoring Dashboard will be skipped"
fi

if ask_yes_no "6️⃣  Install Lakes and Zones Search functionality?"; then
    INSTALL_LAKES_ZONES=true
    echo "   ✅ Lakes and Zones Search will be installed"
else
    echo "   ❌ Lakes and Zones Search will be skipped"
fi

echo ""
echo "📋 Installation Summary:"
echo "========================"
echo "Data Discovery: $([ "$INSTALL_DATA_DISCOVERY" = true ] && echo "✅ Yes" || echo "❌ No")"
echo "Impact Analysis: $([ "$INSTALL_IMPACT_ANALYSIS" = true ] && echo "✅ Yes" || echo "❌ No")"
echo "Transfer at Scale: $([ "$INSTALL_TRANSFER_AT_SCALE" = true ] && echo "✅ Yes" || echo "❌ No")"
echo "Clean Up: $([ "$INSTALL_CLEAN_UP" = true ] && echo "✅ Yes" || echo "❌ No")"
echo "Monitoring Dashboard: $([ "$INSTALL_MONITORING" = true ] && echo "✅ Yes" || echo "❌ No")"
echo "Lakes and Zones Search: $([ "$INSTALL_LAKES_ZONES" = true ] && echo "✅ Yes" || echo "❌ No")"
echo ""

if ! ask_yes_no "Proceed with installation?"; then
    echo "Installation cancelled by user."
    exit 0
fi

# ---------- Validate Configuration ----------
echo ""
echo "Validating configuration..."
echo "----------------------------------------------------"

echo "Getting current GCP project..."
VALIDATION_FAILED=false
PROJECT_ID=$(gcloud config get-value project 2>/dev/null)

if [[ -z "$PROJECT_ID" || "$PROJECT_ID" == "(unset)" || "$PROJECT_ID" == "None" ]]; then
  echo ""
  echo "❌ Error: Failed to get current GCP project ID."
  echo ""
  echo "Please set an active project using:"
  echo "   gcloud config set project {projectId}"
  echo ""
  echo "Replace {projectId} with your actual project ID."
  echo "This project will be used for transfer tooling deployment."
  echo ""
  VALIDATION_FAILED=true
fi

if [[ -z "$SCOPE" ]]; then
    echo "❌ Error: SCOPE must be configured before running the script."
    echo "Please set SCOPE in the configuration section."
    echo "Example: SCOPE=\"organizations/123456789012\""
    echo ""
    VALIDATION_FAILED=true
fi

if [[ -z "$SERVICE_ACCOUNT" ]]; then
    echo "❌ Error: SERVICE_ACCOUNT must be configured before running the script."
    echo "Please set SERVICE_ACCOUNT in the configuration section."
    echo "Example: SERVICE_ACCOUNT=\"your-service-account@your-project.iam.gserviceaccount.com\""
    echo ""
    VALIDATION_FAILED=true
fi

if [ "$INSTALL_LAKES_ZONES" = true ] && [[ -z "$ASPECT_TYPE_PROJECT_ID" ]]; then
    echo "❌ Error: ASPECT_TYPE_PROJECT_ID must be configured when Lakes and Zones functionality is selected."
    echo "Please set ASPECT_TYPE_PROJECT_ID in the configuration section."
    echo "Example: ASPECT_TYPE_PROJECT_ID=\"your-aspect-project-id\""
    echo ""
    VALIDATION_FAILED=true
fi

if [ "$VALIDATION_FAILED" = true ]; then
    echo ""
    echo "Please fix the configuration errors above and run the script again."
    exit 1
fi

echo "✅ Using project: $PROJECT_ID (project used for transfer tooling)"
echo "✅ All configuration parameters validated successfully!"

# ---------- try wrapper ----------
try() {
 if [ "$DEBUG" = true ]; then
   "$@"
 else
   "$@" >/dev/null 2>&1
 fi
 local code=$?
 if [[ $code -ne 0 ]]; then
   echo "❌ Command failed: $*"
   FAILED_ACTIONS+=("$*")
 fi
 return $code
}

# # ---------- Enable Required APIs ----------
APIS=(
  cloudresourcemanager.googleapis.com
  bigquery.googleapis.com
  cloudtasks.googleapis.com
  run.googleapis.com
  datacatalog.googleapis.com
  cloudasset.googleapis.com
  dataplex.googleapis.com
  cloudscheduler.googleapis.com
  cloudquotas.googleapis.com
)

echo ""
echo "🛠️ Starting to enable APIs for project: $PROJECT_ID"
echo "----------------------------------------------------"

API_FAILED=false
for API in "${APIS[@]}"; do
  echo "Enabling $API ..."
  if try gcloud services enable "$API" --project="$PROJECT_ID"; then
    echo "$API enabled."
  else
    API_FAILED=true
  fi
done

if [[ "$API_FAILED" = false ]]; then
  echo "✅ All required APIs enabled successfully!"
else
  echo "⚠️ Some APIs failed to enable. See above for details."
fi

# ---------- Arguments ----------
BASE_ARGS="main.py -p $PROJECT_ID"

# ---------- Build the IMAGES_ARGS array based on user selection ----------
declare -A IMAGES_ARGS=()

if [ "$INSTALL_DATA_DISCOVERY" = true ]; then
    IMAGES_ARGS[fetch-projects-handler]="$BASE_ARGS"
    IMAGES_ARGS[fetch-resources-handler]="$BASE_ARGS"
    IMAGES_ARGS[fetch-projects-job]="$BASE_ARGS"
    IMAGES_ARGS[fetch-resources-job]="$BASE_ARGS"
fi

if [ "$INSTALL_IMPACT_ANALYSIS" = true ]; then
    IMAGES_ARGS[find-resource-names-handler]="$BASE_ARGS"
    IMAGES_ARGS[fetch-policies-handler]="$BASE_ARGS"
    IMAGES_ARGS[find-resource-names-job]="$BASE_ARGS"
    IMAGES_ARGS[audit-logs-job]="$BASE_ARGS"
    IMAGES_ARGS[fetch-policies-job]="$BASE_ARGS -s $SCOPE"
fi

if [ "$INSTALL_TRANSFER_AT_SCALE" = true ]; then
    IMAGES_ARGS[convert-private-tag-templates-handler]="$BASE_ARGS"
    IMAGES_ARGS[transfer-resources-handler]="$BASE_ARGS"
    IMAGES_ARGS[convert-private-tag-templates-job]="$BASE_ARGS -s $SCOPE"
    IMAGES_ARGS[transfer-resources-job]="$BASE_ARGS -s $SCOPE"
fi

if [ "$INSTALL_CLEAN_UP" = true ]; then
    IMAGES_ARGS[clean-up-handler]="main.py"
    IMAGES_ARGS[clean-up-job]="$BASE_ARGS -s $SCOPE"
fi

if [ "$INSTALL_MONITORING" = true ]; then
    IMAGES_ARGS[analytics-job]="$BASE_ARGS"
fi

if [ "$INSTALL_LAKES_ZONES" = true ]; then
    IMAGES_ARGS[lakes-handler]="main.py"
    IMAGES_ARGS[lakes-job]="$BASE_ARGS -atp $ASPECT_TYPE_PROJECT_ID"
fi

if [ ${#IMAGES_ARGS[@]} -eq 0 ]; then
    echo "❌ No components selected for installation. Exiting."
    exit 0
fi

# ---------- Build Job Configuration based on user selection ----------
declare -A JOB_MEMORY=()
declare -A JOB_TIMEOUTS=()
declare -A JOB_CPU=()

if [ "$INSTALL_IMPACT_ANALYSIS" = true ]; then
    JOB_MEMORY[find-resource-names-job]="2Gi"
    JOB_MEMORY[fetch-policies-job]="1Gi"
    JOB_TIMEOUTS[find-resource-names-job]=36000
    JOB_TIMEOUTS[fetch-policies-job]=7200
fi

if [ "$INSTALL_TRANSFER_AT_SCALE" = true ]; then
    JOB_MEMORY[transfer-resources-job]="4Gi"
    JOB_TIMEOUTS[convert-private-tag-templates-job]=3600
    JOB_TIMEOUTS[transfer-resources-job]=7200
fi

if [ "$INSTALL_LAKES_ZONES" = true ]; then
    JOB_TIMEOUTS[lakes-job]=14400
    JOB_CPU[lakes-job]=2
fi

# Random base hour and job schedule calculation
random_base_hour=$((RANDOM % 4))

fetch_projects_hour=$random_base_hour
fetch_resources_hour=$((random_base_hour + 1))
find_resource_names_hour=$((random_base_hour + 2))
analytics_hour=$((random_base_hour + 14))
fetch_policies_hour=$((random_base_hour + 15))
lakes_hour=$((RANDOM % 24))

# ---------- Define cron schedule for jobs ----------
declare -A JOB_SCHEDULES=()

if [ "$INSTALL_DATA_DISCOVERY" = true ]; then
    JOB_SCHEDULES[fetch-projects-job]="0 $fetch_projects_hour * * *"
    JOB_SCHEDULES[fetch-resources-job]="0 $fetch_resources_hour * * *"
fi

if [ "$INSTALL_IMPACT_ANALYSIS" = true ]; then
    JOB_SCHEDULES[find-resource-names-job]="0 $find_resource_names_hour * * *"
    JOB_SCHEDULES[fetch-policies-job]="0 $fetch_policies_hour * * *"
fi

if [ "$INSTALL_MONITORING" = true ]; then
    JOB_SCHEDULES[analytics-job]="50 $analytics_hour * * *"
fi

if [ "$INSTALL_LAKES_ZONES" = true ]; then
    JOB_SCHEDULES[lakes-job]="0 $lakes_hour * * *"
fi

# # ---------- Artifact Registry Auth ----------
REGISTRY_HOSTNAME=$(echo "$REGISTRY" | cut -d'/' -f1)
echo ""
echo "🔒 Authenticating Docker with Artifact Registry..."
echo "----------------------------------------------------"
try gcloud auth configure-docker "$REGISTRY_HOSTNAME"

# ---------- Deploy Selected Images ----------
echo ""
echo "🚀 Starting pull + deploy process for selected images..."
echo "----------------------------------------------------"

DEPLOYMENT_FAILED=false

for IMAGE in "${!IMAGES_ARGS[@]}"; do
  FULL_IMAGE="$REGISTRY/$IMAGE:latest"
  echo "Pulling $FULL_IMAGE ..."
  try docker pull "$FULL_IMAGE" && echo "Pulled $FULL_IMAGE" || {
    echo "Skipping deployment for $FULL_IMAGE due to pull failure."
    DEPLOYMENT_FAILED=true
    continue
  }

  ARGS="${IMAGES_ARGS[$IMAGE]}"
  ARG_LIST=$(echo "$ARGS" | tr ' ' ',')

  if [[ "$IMAGE" == *"-job" ]]; then
    echo "Deploying $IMAGE as a Cloud Run **Job**..."

   MEMORY=${JOB_MEMORY[$IMAGE]:-512Mi}
   TASK_TIMEOUT=${JOB_TIMEOUTS[$IMAGE]:-600}
   CPU=${JOB_CPU[$IMAGE]:-1}

    try gcloud run jobs deploy "$IMAGE" \
      --image="$FULL_IMAGE" \
      --region="$REGION" \
      --project="$PROJECT_ID" \
      --command="python3" \
      --args="$ARG_LIST" \
      --max-retries=3 \
      --memory="$MEMORY" \
      --cpu="$CPU" \
      --task-timeout="${TASK_TIMEOUT}s" \
      --service-account $SERVICE_ACCOUNT || DEPLOYMENT_FAILED=true

    echo "Granting Cloud Scheduler permission to invoke $IMAGE"
    try gcloud run jobs add-iam-policy-binding "$IMAGE" \
        --member="serviceAccount:$SERVICE_ACCOUNT" \
        --role="roles/run.invoker" \
        --region="$REGION" || DEPLOYMENT_FAILED=true

    if [[ -n "${JOB_SCHEDULES[$IMAGE]}" ]]; then
        SCHEDULE="${JOB_SCHEDULES[$IMAGE]}"
        echo "Cloud Scheduler for $IMAGE → $SCHEDULE"

        # Check if scheduler exists and delete if found
        if gcloud scheduler jobs describe "$IMAGE-schedule" --location="$REGION" >/dev/null 2>&1; then
            echo "Deleted older scheduler: $IMAGE-schedule"
            gcloud scheduler jobs delete "$IMAGE-schedule" \
                --location="$REGION" \
                --quiet >/dev/null 2>&1
        fi
    
        try gcloud scheduler jobs create http "$IMAGE-schedule" \
        --schedule="$SCHEDULE" \
        --uri="https://${REGION}-run.googleapis.com/apis/run.googleapis.com/v1/namespaces/${PROJECT_ID}/jobs/$IMAGE:run" \
        --http-method=POST \
        --oauth-service-account-email="$SERVICE_ACCOUNT" \
        --location="$REGION" \
        --message-body="{}" \
        --time-zone="UTC" \
        --attempt-deadline="300s" || DEPLOYMENT_FAILED=true
    fi
  else
    echo "Deploying $IMAGE as a Cloud Run **Service**..."
    try gcloud run deploy "$IMAGE" \
      --image="$FULL_IMAGE" \
      --command="python3" \
      --args="$ARG_LIST" \
      --platform=managed \
      --ingress=internal-and-cloud-load-balancing \
      --no-allow-unauthenticated \
      --region="$REGION" \
      --project="$PROJECT_ID" \
      --service-account $SERVICE_ACCOUNT || DEPLOYMENT_FAILED=true
  fi

done

if [[ "$DEPLOYMENT_FAILED" = false ]]; then
  echo "✅ All selected handlers deployed as services and jobs deployed as Cloud Run jobs!"
else
  echo "⚠️ Some handlers or jobs failed to deploy. See above for details."
fi


 # ---------- Post-deploy: Audit Log Sink Creation Job ----------
run_audit_log_sink_job() {
  echo ""
  echo "📜 Executing audit log sink creation job..."
  echo "----------------------------------------------------"

  if ! try gcloud run jobs execute audit-logs-job --region="$REGION"; then
    echo "⚠️ Audit log sink creation job failed!"
    return 1
  fi

  echo "Waiting for sink propagation... (~3 minutes)"
  sleep 120

  echo "Retrieving sink writer identity..."
  WRITER_IDENTITY=$(gcloud logging sinks describe "$SINK_NAME" \
    --project="$PROJECT_ID" \
    --format='value(writerIdentity)' )

  echo "Writer Identity: $WRITER_IDENTITY"

  echo "Granting BigQuery permissions to sink writer identity..."
  try gcloud projects add-iam-policy-binding "$PROJECT_ID" \
    --member="$WRITER_IDENTITY" \
    --role="roles/bigquery.dataEditor" \
    --condition=None

  echo "✅ Audit log sink creation completed successfully!"
}

if [ "$INSTALL_IMPACT_ANALYSIS" = true ]; then
    if ! run_audit_log_sink_job; then
        echo ""
        echo "⚠️ Skipping remaining post-deploy steps due to audit log sink job failure."
    fi
fi

# ---------- Final Report And Next Steps----------
echo ""
if [[ ${#FAILED_ACTIONS[@]} -eq 0 ]]; then
 echo "🐱 All operations completed successfully!"
 echo ""
 if [ "$INSTALL_IMPACT_ANALYSIS" = true ]; then
  echo "🎉 Next Step:"
  echo ""
  echo "   Enable Data Access Logs via the Google Cloud Console:"
  echo "   - Go to the Audit Logs page in the Google Cloud Console."
  echo "   - Locate 'Data Catalog' in the Service column of the Data Access audit logs configuration table."
  echo "   - **Important**: Make sure you are at the ORGANIZATION level (not project level)."
  echo "   - Select your organization from the project/organization picker at the top."
  echo "   - Click on 'Data Catalog' to open the configuration panel."
  echo "   - In the 'Log Types' tab, select the Data Access audit log types you want to enable:"
  echo "     - DATA_READ"
  echo "     - DATA_WRITE"
  echo "     - ADMIN_READ"
  echo "   - Go to the 'Exempted Principals' tab in the information panel."
  echo "   - Click 'Add exempted principal' and add the service account used by transfer tooling (e.g., service-account@project-id.iam.gserviceaccount.com)."
  echo "   - In the **Disabled permission types** section for the exempted principal, select audit log types that you want to disable:"
  echo "     - ADMIN_READ"
  echo "     - DATA_READ"
  echo "     - DATA_WRITE"
  echo "   - Click 'Done'."
  echo "   - Click 'Save'."
  echo ""
  echo "   Note: Organization-level audit logs ensure comprehensive coverage across all projects"
  echo "   and prevent the need to configure audit logs individually for each project."
  echo ""
 fi
else
 echo "🙀 The following operations failed:"
 for action in "${FAILED_ACTIONS[@]}"; do
   echo "  - $action"
 done
fi